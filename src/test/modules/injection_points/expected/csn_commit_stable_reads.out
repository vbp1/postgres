step o_capture_prepub_fxid: 
	UPDATE csn_commit_stable_reads_state
	SET fxid = (
		SELECT objid::text::xid8
		FROM pg_locks
		WHERE locktype = 'advisory'
		  AND classid = 1
		  AND pid = (
			SELECT pid
			FROM csn_commit_stable_reads_state
			WHERE label = 'prepub'
		  )
	)
	WHERE label = 'prepub';
	SELECT fxid IS NOT NULL AS writer_fxid_captured
	FROM csn_commit_stable_reads_state
	WHERE label = 'prepub';

