step w_begin_new: 
	BEGIN;

step o_old_gone_new_visible: 
	SELECT EXISTS (
		SELECT 1
		FROM pg_locks
		WHERE locktype = 'virtualxid'
		  AND virtualtransaction = (
			SELECT vxid
			FROM csn_ordinary_vxid_lifecycle_state
			WHERE label = 'old'
		  )
	) AS old_vxid_visible,
	EXISTS (
		SELECT 1
		FROM pg_locks
		WHERE locktype = 'virtualxid'
		  AND pid = (
			SELECT vxid::int
			FROM csn_ordinary_vxid_lifecycle_state
			WHERE label = 'pid'
		  )
	) AS writer_vxid_visible;

old_vxid_visible|writer_vxid_visible
----------------+-------------------
f               |t                  
