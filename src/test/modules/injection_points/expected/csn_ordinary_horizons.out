step o_before_capture: 
	UPDATE csn_ordinary_horizons_state
	SET fxid = (
		SELECT objid::text::xid8
		FROM pg_locks
		WHERE locktype = 'advisory'
		  AND classid = 1
		  AND pid = (
			SELECT pid
			FROM csn_ordinary_horizons_state
			WHERE label = 'before'
		  )
	)
	WHERE label = 'before';
	SELECT fxid IS NOT NULL AS before_fxid_captured
	FROM csn_ordinary_horizons_state
	WHERE label = 'before';

