step o_after_xmin: 
	SELECT
		EXISTS (
			SELECT 1
			FROM pg_locks
			WHERE locktype = 'virtualxid'
			  AND pid = (
				SELECT value::int
				FROM csn_ordinary_snapshot_xmin_state_meta
				WHERE label = 'pid'
			  )
		) AS writer_vxid_visible,
		(
			SELECT backend_xmin IS NOT NULL
			FROM pg_stat_activity
			WHERE pid = (
				SELECT value::int
				FROM csn_ordinary_snapshot_xmin_state_meta
				WHERE label = 'pid'
			)
		) AS backend_xmin_is_set;

